# Environment files
.env
.env.*
!.env.example
!.env.*.example

# Local tool configuration
.mcpservers.json

# Firebase / Google Cloud server-side secrets
**/*serviceAccount*.json
**/firebase-adminsdk*.json
**/*adminsdk*.json
**/*service-account*.json

# Apple push notification keys and certificates
**/AuthKey_*.p8
**/*.p8
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.mobileprovision
**/*.provisionprofile

# Android signing keys
**/key.properties
**/*.keystore
**/*.jks

node_modules/
dist/

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
**/android/app/debug
**/android/app/profile
**/android/app/release

# Generated prototype mapping artifacts
**/prototype-*.json
**/prototype-*.txt
